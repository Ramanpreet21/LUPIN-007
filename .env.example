# incident-agent control plane configuration
# All config is environment-driven. Export these before running `incident-agent serve`.

# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# TrueForge (TrueForge Agent Harness Server; @truefoundry/trueforge-sdk)
# Required for the TrueForge client to be constructed:
TRUEFORGE_BASE_URL=http://localhost:8765
# Optional: bearer token (ID token) when the harness server requires auth:
TRUEFORGE_TOKEN=
